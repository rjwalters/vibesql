{
  "name": "@vibesql/drizzle",
  "version": "0.1.3",
  "description": "Drizzle ORM adapter for VibeSQL using sqlite-proxy driver",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./migrator": {
      "import": "./dist/migrator.js",
      "require": "./dist/migrator.js",
      "types": "./dist/migrator.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@vibesql/client": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@vibesql/client": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "vibesql",
    "drizzle",
    "drizzle-orm",
    "sqlite-proxy",
    "sql",
    "real-time",
    "subscriptions",
    "reactive",
    "typescript",
    "orm"
  ],
  "license": "MIT OR Apache-2.0"
}
