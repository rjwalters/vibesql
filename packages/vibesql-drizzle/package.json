{
  "name": "@vibesql/drizzle",
  "version": "0.1.3",
  "description": "Drizzle ORM adapter for VibeSQL using sqlite-proxy driver",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./migrator": {
      "import": "./dist/migrator.js",
      "require": "./dist/migrator.js",
      "types": "./dist/migrator.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@vibesql/client": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@vibesql/client": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "vibesql",
    "drizzle",
    "drizzle-orm",
    "sqlite-proxy",
    "sql",
    "real-time",
    "subscriptions",
    "reactive",
    "typescript",
    "orm"
  ],
  "license": "MIT OR Apache-2.0"
}
