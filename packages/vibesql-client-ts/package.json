{
  "name": "@vibesql/client",
  "version": "0.1.3",
  "description": "TypeScript client for VibeSql with real-time subscription support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "vibesql",
    "database",
    "realtime",
    "subscriptions",
    "postgresql",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rjwalters/vibesql",
    "directory": "packages/vibesql-client-ts"
  },
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.2",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.0"
  }
}
