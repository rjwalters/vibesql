{
  "name": "@vibesql/client",
  "version": "0.1.0",
  "description": "TypeScript SDK for VibeSQL with real-time subscription support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesOptional": {
    "react": "*",
    "react-dom": "*"
  },
  "keywords": [
    "vibesql",
    "sql",
    "real-time",
    "subscriptions",
    "reactive",
    "typescript"
  ],
  "license": "MIT OR Apache-2.0"
}
