#!/usr/bin/env python3
"""
Unified benchmark CLI for VibeSQL.

Provides a consistent interface for running all benchmarks (TPC-H, TPC-C, TPC-DS, Sysbench)
with support for engine selection, query filtering, configuration options, and JSON export.

Usage:
    ./scripts/bench --test=tpch                     # Run TPC-H (VibeSQL only)
    ./scripts/bench --test=tpcc --engine=mysql      # Run TPC-C with MySQL
    ./scripts/bench --test=all --engine=all         # Full matrix
    ./scripts/bench --json                          # Export results as JSON

Examples:
    ./scripts/bench --test=tpch --engine=vibesql,duckdb
    ./scripts/bench --test=tpcc --duration=120
    ./scripts/bench --test=tpcds --scale=0.01
    ./scripts/bench --test=tpch --query=Q1,Q6
    ./scripts/bench --quick                         # Fast subset for CI
    ./scripts/bench --all                           # All benchmarks (eq: make benchmark)
    ./scripts/bench --json --output=results.json    # Export to JSON file
"""

import argparse
import json
import os
import platform
import subprocess
import sys
from dataclasses import dataclass, asdict
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional


def strip_quarantine():
    """Remove macOS quarantine attribute from built binaries.

    macOS Gatekeeper can flag freshly-compiled binaries as 'malware' because
    they aren't code-signed. This removes the quarantine extended attribute
    to prevent false positive blocks.
    """
    if platform.system() != "Darwin":
        return

    target_dir = Path(__file__).parent.parent / "target"
    if not target_dir.exists():
        return

    # Remove quarantine from all executables in target/
    subprocess.run(
        ["find", str(target_dir), "-type", "f", "-perm", "+111",
         "-exec", "xattr", "-d", "com.apple.quarantine", "{}", ";"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )


@dataclass
class BenchConfig:
    """Benchmark configuration."""
    test: str                          # 'tpch', 'tpcc', 'tpcds', 'sysbench', or 'all'
    engines: List[str]                 # ['vibesql', 'sqlite', 'duckdb', 'mysql']
    queries: Optional[List[str]] = None  # ['Q1', 'Q6'] or None for all
    transactions: Optional[List[str]] = None  # ['new-order', 'payment'] for TPC-C
    timeout: Optional[int] = None      # Per-query timeout in seconds
    duration: Optional[int] = None     # Benchmark duration in seconds
    scale: Optional[float] = None      # Scale factor
    output: Optional[str] = None       # Output file path
    test_mode: bool = False            # Test mode for pipeline validation
    quick: bool = False                # Quick mode for CI (reduced iterations)
    json_export: bool = False          # Export results to JSON
    verbose: bool = False              # Verbose output
    sample_size: Optional[int] = None  # Criterion sample size (iterations per query)
    measurement_time: Optional[int] = None  # Criterion measurement time in seconds


@dataclass
class BenchmarkResult:
    """Result from a single benchmark run."""
    test: str
    status: str  # 'success', 'partial', 'failed'
    duration_secs: float
    queries_passed: int = 0
    queries_total: int = 0
    tps: Optional[float] = None  # Transactions per second (TPC-C)
    error: Optional[str] = None
    details: Optional[Dict[str, Any]] = None


def get_git_info() -> Dict[str, str]:
    """Get current git commit hash and branch name."""
    try:
        commit = subprocess.check_output(
            ["git", "rev-parse", "HEAD"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()[:8]  # Short hash

        branch = subprocess.check_output(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()

        return {"commit": commit, "branch": branch}
    except:
        return {"commit": "unknown", "branch": "unknown"}


def create_parser() -> argparse.ArgumentParser:
    """Create and configure argument parser."""
    parser = argparse.ArgumentParser(
        prog="./scripts/bench",
        description="Unified VibeSQL benchmark runner",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./scripts/bench --test=tpch                     Run TPC-H with VibeSQL
  ./scripts/bench --test=tpch --engine=sqlite     Run TPC-H vs SQLite
  ./scripts/bench --test=tpcc --engine=mysql      Run TPC-C with MySQL
  ./scripts/bench --test=all                      Run all benchmarks (2+ hours)
  ./scripts/bench --test=all --quick              Quick CI run (~15-20 min)
  ./scripts/bench --smoke                         Smoke test - pipeline validation (~30s)
  ./scripts/bench --smoke --all                   Smoke test ALL benchmarks
  ./scripts/bench --test=tpch --query=Q1,Q6       Run only Q1 and Q6 queries
  ./scripts/bench --test=tpcds --query=Q4,Q11     Run specific TPC-DS queries
  ./scripts/bench --test=tpcc --txn=new-order     Run only new-order transactions
  ./scripts/bench --test=tpcc --duration=120      Run TPC-C for 120s
  ./scripts/bench --sample-size=5                 Run with fewer iterations

Query Filter (--query):
  Works with TPC-H and TPC-DS benchmarks.
  Format: Comma-separated list of query names (e.g., Q1,Q6,Q9)
  Query names are case-insensitive.

Transaction Filter (--txn):
  Works with TPC-C benchmark.
  Valid values: new-order, payment, order-status, delivery, stock-level, mixed
  Only single transaction type supported (multiple values ignored).
        """)

    # Test selection
    parser.add_argument(
        "--test",
        choices=["tpch", "tpcc", "tpcds", "sysbench", "all"],
        default="tpch",
        help="Benchmark to run (default: tpch)"
    )

    # Engine selection
    parser.add_argument(
        "--engine",
        type=str,
        default="vibesql",
        help="Engines to compare (comma-separated): vibesql,sqlite,duckdb,mysql (default: vibesql)"
    )

    # Query/transaction filtering
    parser.add_argument(
        "--query",
        type=str,
        help="Filter queries for TPC-H/TPC-DS (comma-separated). Examples: Q1,Q6,Q9"
    )

    parser.add_argument(
        "--txn",
        type=str,
        help="Filter transaction type for TPC-C. Options: new-order, payment, order-status, delivery, stock-level, mixed"
    )

    # Timing options
    parser.add_argument(
        "--timeout",
        type=int,
        help="Per-query timeout in seconds (TPC-H/TPC-DS)"
    )

    parser.add_argument(
        "--duration",
        type=int,
        help="Benchmark duration in seconds (TPC-C/Sysbench)"
    )

    # Scale factor
    parser.add_argument(
        "--scale",
        type=float,
        help="Scale factor (TPC-DS default: 1, TPC-C default: 1)"
    )

    # Output
    parser.add_argument(
        "--output",
        "-o",
        type=str,
        help="Output file path (optional)"
    )

    # Convenience flags
    parser.add_argument(
        "--quick",
        action="store_true",
        help="Quick mode for CI (~15-20 min instead of 2+ hours). Reduces Criterion iterations (sample_size=10, measurement_time=3s)"
    )

    parser.add_argument(
        "--smoke",
        action="store_true",
        help="Smoke test mode for pipeline validation (~30s total). Runs minimal queries/duration to validate data collection and storage."
    )

    parser.add_argument(
        "--all",
        action="store_true",
        help="Equivalent to: --test=all (all benchmarks)"
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Export results to JSON format (writes to --output if specified, else stdout)"
    )

    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Verbose output with detailed timing information"
    )

    # Criterion benchmark settings (for TPC-H/TPC-DS)
    parser.add_argument(
        "--sample-size",
        type=int,
        help="Number of iterations per query (Criterion sample size). Default: 100, --quick: 10"
    )

    parser.add_argument(
        "--measurement-time",
        type=int,
        help="Measurement time per query in seconds (Criterion). Default: 5, --quick: 3"
    )

    return parser


def parse_engines(engine_str: str) -> List[str]:
    """Parse engine string and validate."""
    valid_engines = {"vibesql", "sqlite", "duckdb", "mysql"}
    
    engines = [e.strip() for e in engine_str.split(",")]
    engines = [e for e in engines if e]  # Remove empty strings
    
    if not engines:
        engines = ["vibesql"]
    
    # Expand 'all'
    if "all" in engines:
        engines = list(valid_engines)
    
    # Validate
    for engine in engines:
        if engine not in valid_engines:
            raise ValueError(f"Invalid engine: {engine}. Valid: {', '.join(valid_engines)}")
    
    return list(set(engines))  # Remove duplicates


def parse_list(list_str: Optional[str]) -> Optional[List[str]]:
    """Parse comma-separated list string."""
    if not list_str:
        return None
    items = [item.strip().upper() for item in list_str.split(",")]
    return [item for item in items if item]


def build_config(args: argparse.Namespace) -> BenchConfig:
    """Build BenchConfig from parsed arguments."""
    test = args.test if not args.all else "all"
    engines = parse_engines(args.engine)

    # Quick mode: limit to VibeSQL only, reduced iterations for faster CI
    # Targets ~15-20 minutes for full benchmark suite instead of 2+ hours
    if args.quick:
        engines = ["vibesql"]
        args.timeout = args.timeout or 10  # Shorter timeout
        # Reduced Criterion settings: 10 samples instead of 100, 3s instead of 5s
        args.sample_size = args.sample_size or 10
        args.measurement_time = args.measurement_time or 3

    # Smoke test mode: ultra-minimal settings for pipeline validation (~30s total)
    # Purpose: Validate data collection, storage, and analysis pipeline
    if args.smoke:
        # Only default to vibesql if no engine was explicitly specified
        if args.engine == "vibesql":  # default value means not explicitly set
            engines = ["vibesql"]
        # else: keep the engines parsed from --engine flag
        args.timeout = args.timeout or 5      # 5s timeout per query
        args.duration = args.duration or 3    # 3s duration for TPC-C/Sysbench
        args.scale = args.scale or 0.001      # Minimal scale factor
        args.sample_size = args.sample_size or 5
        args.measurement_time = args.measurement_time or 1
        # Limit to fastest queries unless explicitly specified
        if not args.query:
            args.query = "Q1,Q6"  # TPC-H fastest queries
        test = "all" if args.all else test
        print("\n" + "=" * 60, flush=True)
        print("SMOKE TEST MODE - Pipeline Validation", flush=True)
        print("=" * 60, flush=True)
        print("Purpose: Validate benchmark → storage → analysis pipeline", flush=True)
        print(f"  Engines:  {', '.join(engines)}", flush=True)
        print(f"  Timeout:  {args.timeout}s per query", flush=True)
        print(f"  Duration: {args.duration}s (TPC-C/Sysbench)", flush=True)
        print(f"  Scale:    {args.scale}", flush=True)
        print(f"  Queries:  {args.query}", flush=True)
        print("=" * 60 + "\n", flush=True)

    config = BenchConfig(
        test=test,
        engines=engines,
        queries=parse_list(args.query),
        transactions=parse_list(args.txn),
        timeout=args.timeout,
        duration=args.duration,
        scale=args.scale,
        output=args.output,
        test_mode=args.smoke,
        quick=args.quick,
        json_export=args.json,
        verbose=args.verbose,
        sample_size=getattr(args, 'sample_size', None),
        measurement_time=getattr(args, 'measurement_time', None),
    )

    return config


def run_tpch(config: BenchConfig) -> int:
    """Run TPC-H benchmark."""
    print("\n" + "=" * 60)
    print("TPC-H Benchmark")
    print("=" * 60)

    timeout = config.timeout or 30

    # Determine which benchmark to run based on engine selection
    # If only vibesql, use the profiling benchmark (faster, detailed timing)
    # If multiple engines, use the Criterion benchmark with all engines
    use_criterion = len(config.engines) > 1 or config.engines != ["vibesql"]

    if use_criterion:
        return run_tpch_criterion(config)
    else:
        return run_tpch_profiling(config, timeout)


def run_tpch_profiling(config: BenchConfig, timeout: int) -> int:
    """Run TPC-H with profiling benchmark (VibeSQL only, detailed timing)."""
    print(f"Mode: Profiling (VibeSQL only, detailed timing breakdown)")
    print(f"Timeout: {timeout}s per query")

    # Set up environment with query filter
    env = os.environ.copy()
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)
        print(f"Query filter: {env['QUERY_FILTER']}")

    # Run the existing bench-tpch.sh script
    cmd = ["./scripts/bench-tpch.sh", "--mode", "standard", "--timeout", str(timeout)]

    print(f"Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, cwd=Path(__file__).parent.parent, env=env)

    if result.returncode != 0:
        print(f"❌ TPC-H benchmark failed")
        return 1

    # Process results into database
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpch", "--input", "/tmp/tpch_results.txt", "--timeout", str(timeout)],
        cwd=Path(__file__).parent.parent
    )

    return result.returncode


def run_tpch_criterion(config: BenchConfig) -> int:
    """Run TPC-H with Criterion benchmark (multi-engine comparison)."""
    print(f"Mode: Criterion (engine comparison)")
    print(f"Engines: {', '.join(config.engines)}")

    # Set up environment
    env = os.environ.copy()

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            mysql_url = result.stdout.strip()
            if mysql_url:
                env["MYSQL_URL"] = mysql_url
                print(f"✓ MySQL ready: {mysql_url}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            if len(config.engines) == 1:
                return 1
            # Continue without MySQL
            config.engines = [e for e in config.engines if e != "mysql"]

    # Build the benchmark binary with appropriate features
    features = ["benchmark-comparison"]
    if "duckdb" in config.engines:
        features.append("duckdb-comparison")
    if "mysql" in config.engines:
        features.append("mysql-comparison")
    features_str = ",".join(features)

    print("\nBuilding benchmark...")
    build_result = subprocess.run(
        ["cargo", "bench", "--package", "vibesql-executor", "--bench", "tpch_benchmark",
         "--features", features_str, "--no-run"],
        cwd=Path(__file__).parent.parent
    )

    if build_result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Run the Criterion benchmark
    print(f"\nRunning TPC-H benchmarks (features: {features_str})...")
    cmd = [
        "cargo", "bench",
        "--package", "vibesql-executor",
        "--bench", "tpch_benchmark",
        "--features", features_str,
        "--", "--noplot"
    ]

    # Add query filter if specified
    if config.queries:
        # Use word boundaries to avoid q1 matching q10, q11, etc.
        # Pattern: tpch_q1[_/] or tpch_q6[_/] to match exact query numbers
        filters = "|".join([f"tpch_q{q.replace('Q', '')}[_/]" for q in config.queries])
        cmd.append(filters)

    result = subprocess.run(
        cmd,
        cwd=Path(__file__).parent.parent,
        env=env
    )

    if result.returncode != 0:
        print("⚠ TPC-H benchmark completed with warnings")
    else:
        print("✓ TPC-H benchmark completed")

    return 0


def run_tpcc(config: BenchConfig) -> int:
    """Run TPC-C benchmark."""
    print("\n" + "=" * 60)
    print("TPC-C Benchmark (OLTP)")
    print("=" * 60)

    # Build features based on selected engines
    features = ["benchmark-comparison"]
    if "duckdb" in config.engines:
        features.append("duckdb-comparison")
    if "mysql" in config.engines:
        features.append("mysql-comparison")
    features_str = ",".join(features)

    # Build benchmark
    print(f"Building TPC-C benchmark (features: {features_str})...")
    result = subprocess.run(
        ["cargo", "bench", "--package", "vibesql-executor", "--bench", "tpcc_benchmark",
         "--features", features_str, "--no-run"],
        cwd=Path(__file__).parent.parent
    )
    
    if result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    duration = config.duration or 60
    # Scale warmup proportionally: 10s for 60s duration, 1s for 3s (fast mode)
    warmup = max(1, duration // 6)
    env["TPCC_DURATION_SECS"] = str(duration)
    env["TPCC_WARMUP_SECS"] = str(warmup)
    env["TPCC_SCALE_FACTOR"] = str(config.scale or 1)
    
    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            if "mysql" in config.engines and len(config.engines) == 1:
                return 1
            # Remove MySQL from engines if it's the only one failing
            config.engines = [e for e in config.engines if e != "mysql"]
    
    # Run benchmark
    print(f"\nRunning TPC-C (duration={duration}s)...")

    # Find benchmark binary - use the most recently modified one
    import glob
    benchmarks = glob.glob("./target/release/deps/tpcc_benchmark-*")
    benchmarks = [b for b in benchmarks if not b.endswith((".d", ".o"))]

    if not benchmarks:
        print("❌ Benchmark binary not found")
        return 1

    # Select most recently modified binary (the one we just built)
    bench_bin = max(benchmarks, key=lambda b: Path(b).stat().st_mtime)

    # Build command with transaction filter if specified
    cmd = [bench_bin]
    if config.transactions and len(config.transactions) == 1:
        # TPC-C benchmark accepts a single transaction type as CLI arg
        txn_type = config.transactions[0].lower().replace("_", "-")
        cmd.append(txn_type)
        print(f"Transaction filter: {txn_type}")
    elif config.transactions and len(config.transactions) > 1:
        print(f"⚠ TPC-C only supports filtering to a single transaction type")
        print(f"   Running 'mixed' workload instead of {config.transactions}")

    with open("/tmp/tpcc_results.txt", "w") as f:
        result = subprocess.run(
            cmd,
            cwd=Path(__file__).parent.parent,
            env=env,
            stdout=f,
            stderr=subprocess.STDOUT
        )
    
    if result.returncode != 0:
        print("⚠ TPC-C benchmark completed with warnings")
    
    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpcc", "--input", "/tmp/tpcc_results.txt",
         "--scale-factor", str(config.scale or 1), "--duration", str(duration)],
        cwd=Path(__file__).parent.parent
    )

    return result.returncode


def run_tpcds(config: BenchConfig) -> int:
    """Run TPC-DS benchmark."""
    print("\n" + "=" * 60)
    print("TPC-DS Benchmark")
    print("=" * 60)

    # Set up environment with query filter
    env = os.environ.copy()
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)
        print(f"Query filter: {env['QUERY_FILTER']}")
    if config.scale:
        env["SCALE_FACTOR"] = str(config.scale)

    # Pass Criterion settings for reduced iterations (--quick mode)
    if config.sample_size:
        env["CRITERION_SAMPLE_SIZE"] = str(config.sample_size)
        print(f"Sample size: {config.sample_size}")
    if config.measurement_time:
        env["CRITERION_MEASUREMENT_TIME"] = str(config.measurement_time)
        print(f"Measurement time: {config.measurement_time}s")

    # Start MySQL Docker container for MySQL comparison
    # Always try to start MySQL for TPC-DS - the isolated script handles it gracefully
    print("\nStarting MySQL Docker container...")
    result = subprocess.run(
        ["./scripts/ensure-mysql-docker.sh"],
        cwd=Path(__file__).parent.parent,
        capture_output=True,
        text=True
    )
    if result.returncode == 0:
        mysql_url = result.stdout.strip()
        if mysql_url:
            env["MYSQL_URL"] = mysql_url
            print(f"✓ MySQL ready: {mysql_url}")
    else:
        print("⚠ MySQL unavailable (Docker not available, skipping MySQL comparison)")

    # Use isolated runner to avoid memory pressure
    print("Running TPC-DS (isolated mode - each engine in separate process)...")

    cmd = ["./scripts/bench-tpcds-isolated.sh", "/tmp/tpcds_results.txt"]
    result = subprocess.run(cmd, cwd=Path(__file__).parent.parent, env=env)

    if result.returncode != 0:
        print("⚠ TPC-DS benchmark completed with warnings")

    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpcds", "--input", "/tmp/tpcds_results.txt"],
        cwd=Path(__file__).parent.parent
    )

    return 0  # Don't fail on process errors


def run_sysbench(config: BenchConfig) -> int:
    """Run Sysbench OLTP benchmark."""
    print("\n" + "=" * 60)
    print("Sysbench OLTP Benchmark")
    print("=" * 60)
    
    # Set up environment
    env = os.environ.copy()
    
    # Try to start MySQL if needed
    if "mysql" in config.engines or "vibesql" in config.engines:
        print("Starting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
    
    # Run benchmark
    print("Running Sysbench OLTP...")

    # Build command with Criterion parameters
    cmd = [
        "cargo", "bench", "--package", "vibesql-executor", "--bench", "sysbench_oltp",
        "--features", "benchmark-comparison", "--", "--noplot"
    ]

    # In fast mode (duration < 10), use minimal Criterion settings
    if config.duration and config.duration < 10:
        cmd.extend(["--sample-size", "5", "--measurement-time", "1"])
        print(f"  Using fast Criterion settings (sample-size=5, measurement-time=1)")

    result = subprocess.run(
        cmd,
        cwd=Path(__file__).parent.parent,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )
    
    # Save output
    with open("/tmp/sysbench_results.txt", "w") as f:
        f.write(result.stdout)
    
    if result.returncode != 0:
        print("⚠ Sysbench benchmark completed with warnings")
    
    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=sysbench", "--criterion-dir", "target/criterion"],
        cwd=Path(__file__).parent.parent
    )

    return 0


def run_sysbench_server(config: BenchConfig) -> int:
    """Run Sysbench server benchmark (VibeSQL server vs MySQL)."""
    print("\n" + "=" * 60)
    print("Sysbench Server Benchmark (PostgreSQL Wire Protocol)")
    print("=" * 60)

    # Build features based on selected engines
    features = []
    if "mysql" in config.engines:
        features.append("mysql-comparison")
    features_str = ",".join(features) if features else ""

    # Build benchmark
    build_cmd = ["cargo", "bench", "--package", "vibesql-executor", "--bench", "sysbench_server", "--no-run"]
    if features_str:
        build_cmd.extend(["--features", features_str])

    print("Building Sysbench server benchmark...")
    result = subprocess.run(build_cmd, cwd=Path(__file__).parent.parent)

    if result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    duration = config.duration or 30
    warmup = max(1, duration // 6)
    env["SYSBENCH_TABLE_SIZE"] = "10000"
    env["SYSBENCH_DURATION_SECS"] = str(duration)
    env["SYSBENCH_WARMUP_SECS"] = str(warmup)

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")

    # Find benchmark binary - use the most recently modified one
    import glob
    benchmarks = glob.glob("./target/release/deps/sysbench_server-*")
    benchmarks = [b for b in benchmarks if not b.endswith((".d", ".o"))]

    if not benchmarks:
        print("❌ Benchmark binary not found")
        return 1

    bench_bin = max(benchmarks, key=lambda b: Path(b).stat().st_mtime)

    print(f"\nRunning Sysbench server (duration={duration}s)...")
    with open("/tmp/sysbench_server_results.txt", "w") as f:
        result = subprocess.run(
            [bench_bin],
            cwd=Path(__file__).parent.parent,
            env=env,
            stdout=f,
            stderr=subprocess.STDOUT
        )

    if result.returncode != 0:
        print("⚠ Sysbench server benchmark completed with warnings")
    else:
        print("✓ Sysbench server benchmark completed")

    # Process results - parse the output and add to sysbench_results.json
    print("\nProcessing server results...")
    _process_sysbench_server_results("/tmp/sysbench_server_results.txt")

    return 0


def _process_sysbench_server_results(results_file: str) -> None:
    """Parse sysbench server results and add to sysbench_results.json."""
    import re

    results_path = Path(results_file)
    if not results_path.exists():
        print(f"  Results file not found: {results_file}")
        return

    content = results_path.read_text()

    # Parse results table:
    # Workload               Operations     Avg Latency      Ops/sec
    # -------------------- ------------ --------------- ------------
    # Point Select                96296        51.38 us        19465
    pattern = r"^(\w[\w\s]+?)\s+(\d+)\s+([\d.]+)\s+us\s+([\d.]+)$"

    benchmarks = []
    for match in re.finditer(pattern, content, re.MULTILINE):
        workload = match.group(1).strip().lower().replace(" ", "_")
        operations = int(match.group(2))
        latency_us = float(match.group(3))

        # Convert latency from microseconds to seconds
        mean_s = latency_us / 1_000_000

        benchmarks.append({
            "name": f"sysbench_{workload}_vibesql_server",
            "stats": {
                "mean": mean_s,
                "stddev": mean_s * 0.05,  # Approximate 5% variance
                "min": mean_s * 0.95,
                "max": mean_s * 1.05,
                "rounds": operations
            }
        })

    if not benchmarks:
        print("  No server benchmark results parsed")
        return

    # Load existing sysbench_results.json and add server results
    json_path = Path(__file__).parent.parent / "web-demo" / "public" / "benchmarks" / "sysbench_results.json"
    if json_path.exists():
        with open(json_path) as f:
            data = json.load(f)
    else:
        data = {"benchmarks": [], "metadata": {}}

    # Remove old server results
    data["benchmarks"] = [b for b in data["benchmarks"] if not b["name"].endswith("_vibesql_server")]

    # Add new server results
    data["benchmarks"].extend(benchmarks)

    # Update metadata
    git_info = get_git_info()
    data["metadata"]["timestamp"] = datetime.now().isoformat()
    data["metadata"]["git_commit"] = git_info.get("commit", "unknown")

    # Write back
    with open(json_path, 'w') as f:
        json.dump(data, f, indent=2)

    print(f"  Added {len(benchmarks)} server benchmark results to {json_path.name}")


def run_footprint(config: BenchConfig) -> int:
    """Run footprint benchmark (binary size, startup time, memory)."""
    print("\n" + "=" * 60)
    print("Footprint Benchmark (Size, Startup, Memory)")
    print("=" * 60)

    # Run the footprint benchmark script
    output_path = Path(__file__).parent.parent / "web-demo" / "public" / "benchmarks" / "footprint_results.json"

    cmd = [
        "python3", "./scripts/benchmark_footprint.py",
        "--output", str(output_path)
    ]

    print("Running footprint benchmark...")
    result = subprocess.run(
        cmd,
        cwd=Path(__file__).parent.parent
    )

    if result.returncode != 0:
        print("⚠ Footprint benchmark completed with warnings")
    else:
        print(f"✓ Footprint results written to {output_path.name}")

    return result.returncode


def format_duration(seconds: float) -> str:
    """Format duration in human-readable form."""
    if seconds < 1:
        return f"{seconds * 1000:.1f}ms"
    elif seconds < 60:
        return f"{seconds:.2f}s"
    elif seconds < 3600:
        mins = int(seconds // 60)
        secs = seconds % 60
        return f"{mins}m {secs:.1f}s"
    else:
        hours = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        return f"{hours}h {mins}m"


def print_summary_table(results: Dict[str, BenchmarkResult]) -> None:
    """Print a formatted summary table of benchmark results."""
    print("\n" + "=" * 70)
    print("BENCHMARK SUMMARY")
    print("=" * 70)
    print(f"{'Benchmark':<12} {'Status':<10} {'Duration':<12} {'Queries':<12} {'Notes'}")
    print("-" * 70)

    for test, result in results.items():
        status_icon = "✓" if result.status == "success" else "⚠" if result.status == "partial" else "✗"
        duration_str = format_duration(result.duration_secs)

        if result.queries_total > 0:
            queries_str = f"{result.queries_passed}/{result.queries_total}"
        elif result.tps:
            queries_str = f"{result.tps:.0f} TPS"
        else:
            queries_str = "-"

        notes = result.error or ""
        print(f"{test.upper():<12} {status_icon:<10} {duration_str:<12} {queries_str:<12} {notes}")

    print("=" * 70)


def export_json_results(results: Dict[str, BenchmarkResult], config: BenchConfig) -> Dict[str, Any]:
    """Export benchmark results to JSON format."""
    git_info = get_git_info()

    # Build JSON structure
    output = {
        "metadata": {
            "timestamp": datetime.now().isoformat(),
            "git_commit": git_info.get("commit", "unknown"),
            "git_branch": git_info.get("branch", "unknown"),
            "config": {
                "engines": config.engines,
                "scale": config.scale,
                "timeout": config.timeout,
                "duration": config.duration,
                "test_mode": config.test_mode,
            }
        },
        "benchmarks": {}
    }

    for test, result in results.items():
        output["benchmarks"][test] = {
            "status": result.status,
            "duration_secs": round(result.duration_secs, 3),
            "queries_passed": result.queries_passed,
            "queries_total": result.queries_total,
        }
        if result.tps:
            output["benchmarks"][test]["tps"] = round(result.tps, 2)
        if result.error:
            output["benchmarks"][test]["error"] = result.error
        if result.details:
            output["benchmarks"][test]["details"] = result.details

    return output


def run_all(config: BenchConfig) -> int:
    """Run all benchmarks."""
    print("\n" + "=" * 60)
    print("Running ALL BENCHMARKS")
    print("=" * 60)

    results: Dict[str, BenchmarkResult] = {}
    start_time = datetime.now()

    # Define benchmark list based on mode
    # In smoke test mode, skip TPC-DS (no query filter support) and server benchmarks (too slow)
    if config.test_mode:
        benchmarks = ["tpch", "tpcc", "sysbench"]
        print("Note: Skipping TPC-DS, server benchmarks, and footprint in smoke test mode")
    else:
        # Full benchmark suite includes server sysbench and footprint
        benchmarks = ["tpch", "tpcc", "tpcds", "sysbench", "sysbench-server", "footprint"]

    for test in benchmarks:
        config.test = test
        print(f"\n[{test.upper()}] Starting...")
        test_start = datetime.now()

        if test == "tpch":
            ret = run_tpch(config)
        elif test == "tpcc":
            ret = run_tpcc(config)
        elif test == "tpcds":
            ret = run_tpcds(config)
        elif test == "sysbench":
            ret = run_sysbench(config)
        elif test == "sysbench-server":
            ret = run_sysbench_server(config)
        elif test == "footprint":
            ret = run_footprint(config)
        else:
            ret = 1

        test_duration = (datetime.now() - test_start).total_seconds()
        results[test] = BenchmarkResult(
            test=test,
            status="success" if ret == 0 else "failed",
            duration_secs=test_duration,
        )

        if ret != 0:
            print(f"⚠ {test.upper()} had issues, continuing...")

    # Print formatted summary
    print_summary_table(results)

    total_duration = (datetime.now() - start_time).total_seconds()
    print(f"\nTotal time: {format_duration(total_duration)}")

    # JSON export if requested
    if config.json_export:
        json_output = export_json_results(results, config)
        if config.output:
            with open(config.output, 'w') as f:
                json.dump(json_output, f, indent=2)
            print(f"\nJSON results written to: {config.output}")
        else:
            print("\n--- JSON Output ---")
            print(json.dumps(json_output, indent=2))

    # Show analysis (unless in JSON mode to stdout)
    if not config.json_export or config.output:
        print("\nRunning analysis...")
        subprocess.run(
            ["./scripts/query_benchmark_results.py", "--latest"],
            cwd=Path(__file__).parent.parent
        )

    # Export results to JSON for web demo
    print("\n" + "=" * 60)
    print("Exporting results to web demo...")
    print("=" * 60)
    subprocess.run(
        ["python3", "./scripts/export_benchmark_json.py", "--all"],
        cwd=Path(__file__).parent.parent
    )

    return 0


def ensure_python_bindings():
    """Ensure Python bindings are built and up to date."""
    print("Checking Python bindings...")

    # Check if vibesql module exists and get its location
    try:
        import vibesql
        module_path = Path(vibesql.__file__).parent
        so_file = module_path / "vibesql.abi3.so"

        if so_file.exists():
            so_mtime = so_file.stat().st_mtime

            # Check if any Rust source files are newer than the .so
            rust_sources = list(Path("crates").rglob("*.rs"))
            newest_rust = max((f.stat().st_mtime for f in rust_sources), default=0)

            if newest_rust > so_mtime:
                print("  Python bindings are outdated, rebuilding...")
            else:
                print("  Python bindings are up to date")
                return True
        else:
            print("  Python bindings not found, building...")
    except ImportError:
        print("  Python bindings not installed, building...")

    # Build and install Python bindings
    result = subprocess.run(
        ["make", "build-python"],
        cwd=Path(__file__).parent.parent,
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        print(f"⚠ Failed to build Python bindings: {result.stderr}")
        return False

    # Find and install the wheel (select most recent by mtime)
    wheels = list(Path("target/wheels").glob("vibesql-*.whl"))
    if wheels:
        wheel_path = max(wheels, key=lambda w: w.stat().st_mtime)
        print(f"  Installing wheel: {wheel_path.name}")
        result = subprocess.run(
            ["pip3", "install", "--force-reinstall", "--quiet", "--break-system-packages", str(wheel_path)],
            cwd=Path(__file__).parent.parent
        )
        if result.returncode == 0:
            print("  ✓ Python bindings installed")
            return True

    print("⚠ Failed to install Python bindings")
    return False


def main():
    """Main entry point."""
    parser = create_parser()
    args = parser.parse_args()

    # Ensure Python bindings are up to date for result storage
    ensure_python_bindings()

    # Parse arguments into config
    try:
        config = build_config(args)
    except ValueError as e:
        print(f"❌ Error: {e}")
        return 1
    
    # Print configuration (unless JSON to stdout)
    if not config.json_export or config.output:
        print(f"Configuration:")
        print(f"  Test:    {config.test}")
        print(f"  Engines: {', '.join(config.engines)}")
        if config.queries:
            print(f"  Queries: {', '.join(config.queries)}")
        if config.transactions:
            print(f"  Txns:    {', '.join(config.transactions)}")
        if config.timeout:
            print(f"  Timeout: {config.timeout}s")
        if config.duration:
            print(f"  Duration: {config.duration}s")
        if config.scale:
            print(f"  Scale:   {config.scale}")
        if config.json_export:
            output_dest = config.output if config.output else "stdout"
            print(f"  JSON:    {output_dest}")
        if config.verbose:
            print(f"  Verbose: enabled")
    
    # Run benchmark(s)
    if config.test == "all":
        return run_all(config)
    elif config.test == "tpch":
        return run_tpch(config)
    elif config.test == "tpcc":
        return run_tpcc(config)
    elif config.test == "tpcds":
        return run_tpcds(config)
    elif config.test == "sysbench":
        return run_sysbench(config)
    else:
        print(f"❌ Unknown test: {config.test}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
