#!/usr/bin/env python3
"""
Unified benchmark CLI for VibeSQL.

Provides a consistent interface for running all benchmarks (TPC-H, TPC-C, TPC-DS, Sysbench)
with support for engine selection, query filtering, configuration options, and JSON export.

Usage:
    ./scripts/bench --test=tpch                     # Run TPC-H (VibeSQL only)
    ./scripts/bench --test=tpcc --engine=mysql      # Run TPC-C with MySQL
    ./scripts/bench --test=all --engine=all         # Full matrix
    ./scripts/bench --json                          # Export results as JSON

Examples:
    ./scripts/bench --test=tpch --engine=vibesql,duckdb
    ./scripts/bench --test=tpcc --duration=120
    ./scripts/bench --test=tpcds --scale=0.01
    ./scripts/bench --test=tpch --query=Q1,Q6
    ./scripts/bench --quick                         # Fast subset for CI
    ./scripts/bench --all                           # All benchmarks (eq: make benchmark)
    ./scripts/bench --json --output=results.json    # Export to JSON file
"""

import argparse
import json
import os
import platform
import subprocess
import sys
from dataclasses import dataclass, asdict
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional


def strip_quarantine():
    """Remove macOS quarantine attribute from built binaries.

    macOS Gatekeeper can flag freshly-compiled binaries as 'malware' because
    they aren't code-signed. This removes the quarantine extended attribute
    to prevent false positive blocks.
    """
    if platform.system() != "Darwin":
        return

    target_dir = Path(__file__).parent.parent / "target"
    if not target_dir.exists():
        return

    # Remove quarantine from all executables in target/
    subprocess.run(
        ["find", str(target_dir), "-type", "f", "-perm", "+111",
         "-exec", "xattr", "-d", "com.apple.quarantine", "{}", ";"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )


@dataclass
class BenchConfig:
    """Benchmark configuration."""
    test: str                          # 'tpch', 'tpcc', 'tpcds', 'sysbench', or 'all'
    engines: List[str]                 # ['vibesql', 'sqlite', 'duckdb', 'mysql']
    queries: Optional[List[str]] = None  # ['Q1', 'Q6'] or None for all
    transactions: Optional[List[str]] = None  # ['new-order', 'payment'] for TPC-C
    timeout: Optional[int] = None      # Per-query timeout in seconds
    duration: Optional[int] = None     # Benchmark duration in seconds
    scale: Optional[float] = None      # Scale factor
    output: Optional[str] = None       # Output file path
    test_mode: bool = False            # Test mode for pipeline validation
    quick: bool = False                # Quick mode for CI (reduced iterations)
    json_export: bool = False          # Export results to JSON
    verbose: bool = False              # Verbose output
    sample_size: Optional[int] = None  # Iterations per query (legacy, unused)
    measurement_time: Optional[int] = None  # Measurement time in seconds (legacy, unused)


@dataclass
class BenchmarkResult:
    """Result from a single benchmark run."""
    test: str
    status: str  # 'success', 'partial', 'failed'
    duration_secs: float
    queries_passed: int = 0
    queries_total: int = 0
    tps: Optional[float] = None  # Transactions per second (TPC-C)
    error: Optional[str] = None
    details: Optional[Dict[str, Any]] = None


def get_git_info() -> Dict[str, str]:
    """Get current git commit hash and branch name."""
    try:
        commit = subprocess.check_output(
            ["git", "rev-parse", "HEAD"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()[:8]  # Short hash

        branch = subprocess.check_output(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()

        return {"commit": commit, "branch": branch}
    except:
        return {"commit": "unknown", "branch": "unknown"}


def record_skipped_engine(test_name: str, engine: str, reason: str) -> None:
    """Record an engine skip so the orchestrator (bench-all) can surface it.

    Some phases of `make benchmark-all` (notably MySQL) can silently drop out
    mid-run if Docker dies after the pre-flight check. Without a record, the
    orchestrator reports "All phases completed successfully!" and the web
    dashboard ships stale data from the previous cycle (see #5644).

    We append a TSV line `<test>\\t<engine>\\t<reason>` to the marker file
    pointed at by the `VIBESQL_BENCH_SKIP_MARKER` env var. If unset, this is
    a no-op — single-shot `./scripts/bench` invocations stay quiet, only
    `./scripts/bench-all` opts in.
    """
    marker = os.environ.get("VIBESQL_BENCH_SKIP_MARKER")
    if not marker:
        return
    try:
        with open(marker, "a") as f:
            # Sanitize: the orchestrator parses lines by tab; replace tabs/newlines.
            safe_reason = reason.replace("\t", " ").replace("\n", " ")
            f.write(f"{test_name}\t{engine}\t{safe_reason}\n")
    except OSError:
        # Don't let bookkeeping errors blow up the benchmark itself.
        pass


def clean_benchmark_crates():
    """Clean benchmark crates to ensure fresh builds.

    This prevents stale incremental builds from causing compilation errors
    when struct fields change in the AST or other shared crates.
    """
    print("Cleaning benchmark crates...")
    crates = ["vibesql-executor", "vibesql-server"]
    for crate in crates:
        subprocess.run(
            ["cargo", "clean", "-p", crate],
            cwd=Path(__file__).parent.parent,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    print("  ✓ Benchmark crates cleaned")


def build_bench_and_get_binary(package: str, bench_name: str, features: Optional[List[str]] = None) -> Optional[str]:
    """Build a benchmark and return the path to the compiled binary.

    This function uses Cargo's --message-format=json to reliably get the
    exact binary path, avoiding issues with stale binaries from different
    feature configurations having different hashes.

    Args:
        package: The Cargo package name (e.g., "vibesql-server")
        bench_name: The benchmark name (e.g., "sysbench_server")
        features: Optional list of features to enable (e.g., ["mysql"])

    Returns:
        Path to the benchmark binary, or None if build failed
    """
    build_cmd = [
        "cargo", "bench",
        "--package", package,
        "--bench", bench_name,
        "--no-run",
        "--message-format=json"
    ]
    if features:
        build_cmd.extend(["--features", ",".join(features)])

    result = subprocess.run(
        build_cmd,
        cwd=Path(__file__).parent.parent,
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        # Print stderr for debugging
        print(result.stderr)
        return None

    # Parse JSON output to find the benchmark binary
    # Cargo emits one JSON object per line
    import json
    for line in result.stdout.strip().split('\n'):
        if not line:
            continue
        try:
            msg = json.loads(line)
            # Look for compiler-artifact messages for our benchmark
            if msg.get("reason") == "compiler-artifact":
                target = msg.get("target", {})
                if target.get("name") == bench_name and target.get("kind") == ["bench"]:
                    executable = msg.get("executable")
                    if executable:
                        return executable
        except json.JSONDecodeError:
            continue

    # Fallback: parse the text output from stderr for the "Executable" line
    # Format: "  Executable benches/foo.rs (target/release/deps/foo-hash)"
    import re
    for line in result.stderr.split('\n'):
        match = re.search(rf'Executable\s+.*{bench_name}.*\((.*)\)', line)
        if match:
            return match.group(1)

    return None


def create_parser() -> argparse.ArgumentParser:
    """Create and configure argument parser."""
    parser = argparse.ArgumentParser(
        prog="./scripts/bench",
        description="Unified VibeSQL benchmark runner",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./scripts/bench --test=tpch                     Run TPC-H with VibeSQL
  ./scripts/bench --test=tpch --engine=sqlite     Run TPC-H vs SQLite
  ./scripts/bench --test=tpcc --engine=mysql      Run TPC-C with MySQL
  ./scripts/bench --test=all                      Run all benchmarks (2+ hours)
  ./scripts/bench --test=all --quick              Quick CI run (~15-20 min)
  ./scripts/bench --smoke                         Smoke test - pipeline validation (~30s)
  ./scripts/bench --smoke --all                   Smoke test ALL benchmarks
  ./scripts/bench --test=tpch --query=Q1,Q6       Run only Q1 and Q6 queries
  ./scripts/bench --test=tpcds --query=Q4,Q11     Run specific TPC-DS queries
  ./scripts/bench --test=tpcc --txn=new-order     Run only new-order transactions
  ./scripts/bench --test=tpcc --duration=120      Run TPC-C for 120s
  ./scripts/bench --sample-size=5                 Run with fewer iterations

Query Filter (--query):
  Works with TPC-H and TPC-DS benchmarks.
  Format: Comma-separated list of query names (e.g., Q1,Q6,Q9)
  Query names are case-insensitive.

Transaction Filter (--txn):
  Works with TPC-C benchmark.
  Valid values: new-order, payment, order-status, delivery, stock-level, mixed
  Only single transaction type supported (multiple values ignored).
        """)

    # Test selection
    # Embedded tests: tpch, tpcc, tpcds, sysbench
    # Server tests: tpch-server, tpcc-server, sysbench-server
    parser.add_argument(
        "--test",
        choices=["tpch", "tpcc", "tpcds", "sysbench", "hnsw", "tpch-server", "tpcc-server", "sysbench-server", "all"],
        default="tpch",
        help="Benchmark to run (default: tpch). Server tests use client-server protocol."
    )

    # Engine selection
    # Embedded engines: vibesql, sqlite, duckdb
    # Server engines: vibesql-server, mysql
    parser.add_argument(
        "--engine",
        type=str,
        default="vibesql",
        help="Engines to compare (comma-separated). Embedded: vibesql,sqlite,duckdb. Server: vibesql-server,mysql"
    )

    # Query/transaction filtering
    parser.add_argument(
        "--query",
        type=str,
        help="Filter queries for TPC-H/TPC-DS (comma-separated). Examples: Q1,Q6,Q9"
    )

    parser.add_argument(
        "--txn",
        type=str,
        help="Filter transaction type for TPC-C. Options: new-order, payment, order-status, delivery, stock-level, mixed"
    )

    # Timing options
    parser.add_argument(
        "--timeout",
        type=int,
        help="Per-query timeout in seconds (TPC-H/TPC-DS)"
    )

    parser.add_argument(
        "--duration",
        type=int,
        help="Benchmark duration in seconds (TPC-C/Sysbench)"
    )

    # Scale factor
    parser.add_argument(
        "--scale",
        type=float,
        help="Scale factor (TPC-DS default: 1, TPC-C default: 1)"
    )

    # Output
    parser.add_argument(
        "--output",
        "-o",
        type=str,
        help="Output file path (optional)"
    )

    # Convenience flags
    parser.add_argument(
        "--quick",
        action="store_true",
        help="Quick mode for CI (~15-20 min instead of 2+ hours). Reduces benchmark iterations."
    )

    parser.add_argument(
        "--smoke",
        action="store_true",
        help="Smoke test mode for pipeline validation (~30s total). Runs minimal queries/duration to validate data collection and storage."
    )

    parser.add_argument(
        "--all",
        action="store_true",
        help="Equivalent to: --test=all (all benchmarks)"
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Export results to JSON format (writes to --output if specified, else stdout)"
    )

    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Verbose output with detailed timing information"
    )

    # Legacy benchmark settings (kept for compatibility, not used by custom harness)
    parser.add_argument(
        "--sample-size",
        type=int,
        help="(Legacy) Number of iterations per query. Use BENCHMARK_ITERATIONS env var instead."
    )

    parser.add_argument(
        "--measurement-time",
        type=int,
        help="(Legacy) Measurement time per query. Use BENCHMARK_TIMEOUT_SECS env var instead."
    )

    return parser


def parse_engines(engine_str: str) -> List[str]:
    """Parse engine string and validate.

    Embedded engines (in-process): vibesql, sqlite, duckdb
    Server engines (client-server): vibesql-server, mysql
    """
    embedded_engines = {"vibesql", "sqlite", "duckdb"}
    server_engines = {"vibesql-server", "mysql"}
    valid_engines = embedded_engines | server_engines

    engines = [e.strip() for e in engine_str.split(",")]
    engines = [e for e in engines if e]  # Remove empty strings

    if not engines:
        engines = ["vibesql"]

    # Expand 'all' to all embedded engines (for backward compatibility)
    # Use 'all-embedded' or 'all-server' for explicit selection
    if "all" in engines:
        engines = list(embedded_engines)
    elif "all-embedded" in engines:
        engines = list(embedded_engines)
    elif "all-server" in engines:
        engines = list(server_engines)

    # Validate
    for engine in engines:
        if engine not in valid_engines:
            raise ValueError(f"Invalid engine: {engine}. Valid embedded: {', '.join(sorted(embedded_engines))}. Valid server: {', '.join(sorted(server_engines))}")

    return list(set(engines))  # Remove duplicates


def is_server_engine(engine: str) -> bool:
    """Check if engine is a server (client-server) engine."""
    return engine in {"vibesql-server", "mysql"}


def is_embedded_engine(engine: str) -> bool:
    """Check if engine is an embedded (in-process) engine."""
    return engine in {"vibesql", "sqlite", "duckdb"}


def parse_list(list_str: Optional[str]) -> Optional[List[str]]:
    """Parse comma-separated list string."""
    if not list_str:
        return None
    items = [item.strip().upper() for item in list_str.split(",")]
    return [item for item in items if item]


def build_config(args: argparse.Namespace) -> BenchConfig:
    """Build BenchConfig from parsed arguments."""
    test = args.test if not args.all else "all"
    engines = parse_engines(args.engine)

    # Quick mode: limit to VibeSQL only, reduced iterations for faster CI
    # Targets ~15-20 minutes for full benchmark suite instead of 2+ hours
    if args.quick:
        engines = ["vibesql"]
        args.timeout = args.timeout or 10  # Shorter timeout

    # Smoke test mode: ultra-minimal settings for pipeline validation
    # Purpose: Validate data collection, storage, and analysis pipeline
    # Run just 1 query per benchmark type × all engines to verify the full matrix
    if args.smoke:
        # For smoke tests, run all embedded engines to validate the pipeline
        # unless user explicitly specified a subset with --engine
        if args.engine == "vibesql":  # default value means not explicitly set
            engines = ["vibesql", "sqlite", "duckdb"]
        # else: keep the engines parsed from --engine flag
        args.timeout = args.timeout or 5      # 5s timeout per query
        args.duration = args.duration or 2    # 2s duration for TPC-C/Sysbench (minimal)
        args.scale = args.scale or 0.001      # Minimal scale factor
        # Run only 1 query per benchmark - just enough to validate pipeline
        if not args.query:
            args.query = "Q6"  # Single fastest TPC-H query
        test = "all" if args.all else test
        print("\n" + "=" * 60, flush=True)
        print("SMOKE TEST MODE - Pipeline Validation", flush=True)
        print("=" * 60, flush=True)
        print("Purpose: Validate benchmark → storage → analysis pipeline", flush=True)
        print(f"  Engines:  {', '.join(engines)}", flush=True)
        print(f"  Timeout:  {args.timeout}s per query", flush=True)
        print(f"  Duration: {args.duration}s (TPC-C/Sysbench)", flush=True)
        print(f"  Scale:    {args.scale}", flush=True)
        print(f"  Query:    {args.query} (1 query per benchmark type)", flush=True)
        print("=" * 60 + "\n", flush=True)

    config = BenchConfig(
        test=test,
        engines=engines,
        queries=parse_list(args.query),
        transactions=parse_list(args.txn),
        timeout=args.timeout,
        duration=args.duration,
        scale=args.scale,
        output=args.output,
        test_mode=args.smoke,
        quick=args.quick,
        json_export=args.json,
        verbose=args.verbose,
        sample_size=getattr(args, 'sample_size', None),
        measurement_time=getattr(args, 'measurement_time', None),
    )

    return config


def run_tpch(config: BenchConfig) -> int:
    """Run TPC-H benchmark."""
    print("\n" + "=" * 60)
    print("TPC-H Benchmark")
    print("=" * 60)

    timeout = config.timeout or 30

    # Determine which benchmark to run based on engine selection
    # If only vibesql, use the profiling benchmark (faster, detailed timing)
    # If multiple engines, use the engine comparison benchmark
    use_comparison = len(config.engines) > 1 or config.engines != ["vibesql"]

    if use_comparison:
        return run_tpch_comparison(config)
    else:
        return run_tpch_profiling(config, timeout)


def run_tpch_profiling(config: BenchConfig, timeout: int) -> int:
    """Run TPC-H with profiling benchmark (VibeSQL only, detailed timing)."""
    print(f"Mode: Profiling (VibeSQL only, detailed timing breakdown)")
    print(f"Timeout: {timeout}s per query")

    # Set up environment with query filter
    env = os.environ.copy()
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)
        print(f"Query filter: {env['QUERY_FILTER']}")

    # Run the existing bench-tpch.sh script
    cmd = ["./scripts/bench-tpch.sh", "--mode", "standard", "--timeout", str(timeout)]

    print(f"Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, cwd=Path(__file__).parent.parent, env=env)

    if result.returncode != 0:
        print(f"❌ TPC-H benchmark failed")
        return 1

    # Process results into database
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpch", "--input", "/tmp/tpch_results.txt", "--timeout", str(timeout)],
        cwd=Path(__file__).parent.parent
    )

    return result.returncode


def run_tpch_comparison(config: BenchConfig) -> int:
    """Run TPC-H with multi-engine comparison benchmark."""
    print(f"Mode: Engine comparison")
    print(f"Engines: {', '.join(config.engines)}")

    # Set up environment
    env = os.environ.copy()

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            mysql_url = result.stdout.strip()
            if mysql_url:
                env["MYSQL_URL"] = mysql_url
                print(f"✓ MySQL ready: {mysql_url}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("tpch", "mysql", "Docker not available")
            if len(config.engines) == 1:
                return 1
            # Continue without MySQL
            config.engines = [e for e in config.engines if e != "mysql"]

    # Build the benchmark binary with appropriate features
    # Always include in-memory-indexes for VibeSQL optimization
    features = ["in-memory-indexes"]
    if "sqlite" in config.engines:
        features.append("sqlite")
    if "duckdb" in config.engines:
        features.append("duckdb")
    if "mysql" in config.engines:
        features.append("mysql")
    features_str = ",".join(features)

    print("\nBuilding benchmark...")
    build_result = subprocess.run(
        ["cargo", "bench", "--package", "vibesql-executor", "--bench", "tpch_benchmark",
         "--features", features_str, "--no-run"],
        cwd=Path(__file__).parent.parent
    )

    if build_result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Set up environment for custom harness
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)
        print(f"  Query filter: {env['QUERY_FILTER']}")
    if config.scale:
        env["SCALE_FACTOR"] = str(config.scale)
        print(f"  Scale factor: {config.scale}")
    if config.timeout:
        env["BENCHMARK_TIMEOUT_SECS"] = str(config.timeout)
        print(f"  Timeout: {config.timeout}s")

    # Set ENGINE_FILTER for runtime engine selection
    # This allows running only specific engines even when all are compiled
    env["ENGINE_FILTER"] = ",".join(config.engines)
    print(f"  Engine filter: {env['ENGINE_FILTER']}")

    # Find and run the benchmark binary
    print(f"\nRunning TPC-H benchmarks (features: {features_str})...")
    import glob
    binaries = sorted(glob.glob("target/release/deps/tpch_benchmark-*"),
                      key=os.path.getmtime, reverse=True)
    binaries = [b for b in binaries if not b.endswith('.d')]

    if not binaries:
        print("❌ Could not find tpch_benchmark binary")
        return 1

    # Run benchmark and capture output for processing
    output_file = "/tmp/tpch_results.txt"
    with open(output_file, 'w') as f:
        result = subprocess.run(
            [binaries[0]],
            cwd=Path(__file__).parent.parent,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )
        # Write output to file and also print it
        print(result.stdout)
        f.write(result.stdout)

    if result.returncode != 0:
        print("⚠ TPC-H benchmark completed with warnings")
    else:
        print("✓ TPC-H benchmark completed")

    # Process results into database
    print("\nProcessing results into database...")
    timeout = config.timeout or 30
    process_result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpch", "--input", output_file, "--timeout", str(timeout)],
        cwd=Path(__file__).parent.parent
    )

    if process_result.returncode != 0:
        print("⚠ Failed to process results into database")

    return 0


def run_tpcc(config: BenchConfig) -> int:
    """Run TPC-C benchmark."""
    print("\n" + "=" * 60)
    print("TPC-C Benchmark (OLTP)")
    print("=" * 60)

    # Build features based on selected engines
    # Always include in-memory-indexes for VibeSQL optimization
    features = ["in-memory-indexes"]
    if "sqlite" in config.engines:
        features.append("sqlite")
    if "duckdb" in config.engines:
        features.append("duckdb")
    if "mysql" in config.engines:
        features.append("mysql")
    features_str = ",".join(features)

    # Build benchmark
    print(f"Building TPC-C benchmark (features: {features_str})...")
    result = subprocess.run(
        ["cargo", "bench", "--package", "vibesql-executor", "--bench", "tpcc_benchmark",
         "--features", features_str, "--no-run"],
        cwd=Path(__file__).parent.parent
    )
    
    if result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    duration = config.duration or 60
    # Scale warmup proportionally: 10s for 60s duration, 1s for 3s (fast mode)
    warmup = max(1, duration // 6)
    env["TPCC_DURATION_SECS"] = str(duration)
    env["TPCC_WARMUP_SECS"] = str(warmup)
    env["TPCC_SCALE_FACTOR"] = str(config.scale or 1)
    
    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("tpcc", "mysql", "Docker not available")
            if "mysql" in config.engines and len(config.engines) == 1:
                return 1
            # Remove MySQL from engines if it's the only one failing
            config.engines = [e for e in config.engines if e != "mysql"]

    # Run benchmark
    print(f"\nRunning TPC-C (duration={duration}s)...")

    # Find benchmark binary - use the most recently modified one
    import glob
    benchmarks = glob.glob("./target/release/deps/tpcc_benchmark-*")
    benchmarks = [b for b in benchmarks if not b.endswith((".d", ".o"))]

    if not benchmarks:
        print("❌ Benchmark binary not found")
        return 1

    # Select most recently modified binary (the one we just built)
    bench_bin = max(benchmarks, key=lambda b: Path(b).stat().st_mtime)

    # Build command with transaction filter if specified
    cmd = [bench_bin]
    if config.transactions and len(config.transactions) == 1:
        # TPC-C benchmark accepts a single transaction type as CLI arg
        txn_type = config.transactions[0].lower().replace("_", "-")
        cmd.append(txn_type)
        print(f"Transaction filter: {txn_type}")
    elif config.transactions and len(config.transactions) > 1:
        print(f"⚠ TPC-C only supports filtering to a single transaction type")
        print(f"   Running 'mixed' workload instead of {config.transactions}")

    with open("/tmp/tpcc_results.txt", "w") as f:
        result = subprocess.run(
            cmd,
            cwd=Path(__file__).parent.parent,
            env=env,
            stdout=f,
            stderr=subprocess.STDOUT
        )
    
    if result.returncode != 0:
        print("⚠ TPC-C benchmark completed with warnings")
    
    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpcc", "--input", "/tmp/tpcc_results.txt",
         "--scale-factor", str(config.scale or 1), "--duration", str(duration)],
        cwd=Path(__file__).parent.parent
    )

    return result.returncode


def run_tpcds(config: BenchConfig) -> int:
    """Run TPC-DS benchmark."""
    print("\n" + "=" * 60)
    print("TPC-DS Benchmark")
    print("=" * 60)

    # Set up environment with query filter
    env = os.environ.copy()
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)
        print(f"Query filter: {env['QUERY_FILTER']}")
    if config.scale:
        env["SCALE_FACTOR"] = str(config.scale)
        print(f"Scale factor: {config.scale}")

    # Start MySQL Docker container for MySQL comparison
    # Always try to start MySQL for TPC-DS - the isolated script handles it gracefully
    print("\nStarting MySQL Docker container...")
    result = subprocess.run(
        ["./scripts/ensure-mysql-docker.sh"],
        cwd=Path(__file__).parent.parent,
        capture_output=True,
        text=True
    )
    if result.returncode == 0:
        mysql_url = result.stdout.strip()
        if mysql_url:
            env["MYSQL_URL"] = mysql_url
            print(f"✓ MySQL ready: {mysql_url}")
    else:
        print("⚠ MySQL unavailable (Docker not available, skipping MySQL comparison)")
        record_skipped_engine("tpcds", "mysql", "Docker not available")

    # Use isolated runner to avoid memory pressure
    print("Running TPC-DS (isolated mode - each engine in separate process)...")

    cmd = ["./scripts/bench-tpcds-isolated.sh", "/tmp/tpcds_results.txt"]
    result = subprocess.run(cmd, cwd=Path(__file__).parent.parent, env=env)

    if result.returncode != 0:
        print("⚠ TPC-DS benchmark completed with warnings")

    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=tpcds", "--input", "/tmp/tpcds_results.txt"],
        cwd=Path(__file__).parent.parent
    )

    return 0  # Don't fail on process errors


def run_sysbench(config: BenchConfig) -> int:
    """Run Sysbench OLTP benchmark."""
    print("\n" + "=" * 60)
    print("Sysbench OLTP Benchmark")
    print("=" * 60)
    print(f"Engines: {', '.join(config.engines)}")

    # Set up environment
    env = os.environ.copy()

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("Starting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("sysbench", "mysql", "Docker not available")
            # Remove MySQL from engines if Docker not available
            config.engines = [e for e in config.engines if e != "mysql"]

    # Build features based on selected engines
    # Always include in-memory-indexes for VibeSQL optimization
    features = ["in-memory-indexes"]
    if "sqlite" in config.engines:
        features.append("sqlite")
    if "duckdb" in config.engines:
        features.append("duckdb")
    if "mysql" in config.engines:
        features.append("mysql")
    features_str = ",".join(features)

    # Build the benchmark binary
    print(f"\nBuilding benchmark...")
    build_result = subprocess.run(
        ["cargo", "bench", "--package", "vibesql-executor", "--bench", "sysbench_benchmark",
         "--features", features_str, "--no-run"],
        cwd=Path(__file__).parent.parent
    )

    if build_result.returncode != 0:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Set up environment for custom harness
    if config.duration:
        env["SYSBENCH_DURATION_SECS"] = str(config.duration)
        print(f"  Duration: {config.duration}s")
    if config.scale:
        env["SYSBENCH_TABLE_SIZE"] = str(int(config.scale * 10000))  # scale 1.0 = 10000 rows
        print(f"  Table size: {int(config.scale * 10000)} rows")

    # Find and run the benchmark binary
    print(f"\nRunning Sysbench OLTP (features: {features_str})...")
    import glob
    binaries = sorted(glob.glob("target/release/deps/sysbench_benchmark-*"),
                      key=os.path.getmtime, reverse=True)
    binaries = [b for b in binaries if not b.endswith('.d')]

    if not binaries:
        print("❌ Could not find sysbench_benchmark binary")
        return 1

    result = subprocess.run(
        [binaries[0]],
        cwd=Path(__file__).parent.parent,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    # Save output
    with open("/tmp/sysbench_results.txt", "w") as f:
        f.write(result.stdout)

    if result.returncode != 0:
        print("⚠ Sysbench benchmark completed with warnings")

    # Process results
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=sysbench", "--input", "/tmp/sysbench_results.txt"],
        cwd=Path(__file__).parent.parent
    )

    return 0


def run_hnsw(config: BenchConfig) -> int:
    """Run the HNSW recall@k quality benchmark (#5466).

    Unlike the latency-oriented suites this measures a *quality* metric: HNSW
    recall@k vs brute-force ground truth across fresh / degraded (lazy delete) /
    compacted index states. VibeSQL-only (recall is an engine-internal metric).
    """
    print("\n" + "=" * 60)
    print("HNSW Recall@k Benchmark")
    print("=" * 60)

    repo_root = Path(__file__).parent.parent

    # Build the benchmark binary (in-memory-indexes keeps benchmark data fast).
    print("\nBuilding benchmark...")
    binary = build_bench_and_get_binary(
        "vibesql-storage", "hnsw_recall_benchmark", features=["in-memory-indexes"]
    )
    if not binary:
        print("❌ Build failed")
        return 1

    strip_quarantine()

    # Allow quick/smoke runs to shrink the dataset for faster pipeline checks.
    env = os.environ.copy()
    if config.test_mode:
        env.setdefault("HNSW_RECALL_DATASET_SIZE", "800")
        env.setdefault("HNSW_RECALL_QUERIES", "40")
    elif config.quick:
        env.setdefault("HNSW_RECALL_DATASET_SIZE", "1500")
        env.setdefault("HNSW_RECALL_QUERIES", "60")

    print("\nRunning HNSW recall benchmark...")
    result = subprocess.run(
        [binary],
        cwd=repo_root,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    print(result.stdout)

    with open("/tmp/hnsw_results.txt", "w") as f:
        f.write(result.stdout)

    # Process results into the dogfooded results DB even if the benchmark
    # binary exited non-zero (an assert! firing means a recall *regression*
    # — we still want the measurements in the DB so the trends dashboard
    # surfaces the drop instead of silently emitting `0 measurements`. See #5645.
    bench_failed = result.returncode != 0
    if bench_failed:
        print("⚠ HNSW recall benchmark exited non-zero (recall invariants not met) — capturing measurements anyway")

    # Only attempt to process if we actually got the expected output table.
    # Avoid feeding empty / build-failure stdout to the parser.
    has_results_block = "--- VibeSQL Recall Results ---" in result.stdout
    if has_results_block:
        print("\nProcessing results into database...")
        proc = subprocess.run(
            ["./scripts/process_results.py", "--type=hnsw", "--input", "/tmp/hnsw_results.txt"],
            cwd=repo_root
        )
        if proc.returncode != 0:
            print("⚠ HNSW result processing failed")
            return proc.returncode
    else:
        print("❌ HNSW benchmark produced no parseable results table")
        return 1

    return 1 if bench_failed else 0


def run_sysbench_server(config: BenchConfig) -> int:
    """Run Sysbench server benchmark (VibeSQL server vs MySQL)."""
    print("\n" + "=" * 60)
    print("Sysbench Server Benchmark (PostgreSQL Wire Protocol)")
    print("=" * 60)

    # Build features based on selected engines
    features = []
    if "mysql" in config.engines:
        features.append("mysql")

    # Build benchmark and get the correct binary path
    print("Building Sysbench server benchmark...")
    bench_bin = build_bench_and_get_binary("vibesql-server", "sysbench_server", features if features else None)

    if not bench_bin:
        print("❌ Build failed")
        return 1

    print(f"  ✓ Built: {bench_bin}")
    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    duration = config.duration or 30
    warmup = max(1, duration // 6)
    env["SYSBENCH_TABLE_SIZE"] = "10000"
    env["SYSBENCH_DURATION_SECS"] = str(duration)
    env["SYSBENCH_WARMUP_SECS"] = str(warmup)

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("sysbench-server", "mysql", "Docker not available")

    print(f"\nRunning Sysbench server (duration={duration}s)...")
    with open("/tmp/sysbench_server_results.txt", "w") as f:
        result = subprocess.run(
            [bench_bin],
            cwd=Path(__file__).parent.parent,
            env=env,
            stdout=f,
            stderr=subprocess.STDOUT
        )

    if result.returncode != 0:
        print("⚠ Sysbench server benchmark completed with warnings")
    else:
        print("✓ Sysbench server benchmark completed")

    # Process results into database using process_results.py
    # This stores server benchmark results (vibesql_server, mysql) in the same
    # database as embedded benchmarks, ensuring they're properly exported
    print("\nProcessing results into database...")
    result = subprocess.run(
        ["./scripts/process_results.py", "--type=sysbench", "--input", "/tmp/sysbench_server_results.txt"],
        cwd=Path(__file__).parent.parent
    )

    if result.returncode != 0:
        print("⚠ Failed to process server results into database")
    else:
        print("✓ Server results stored in database")

    return 0


def run_tpch_server(config: BenchConfig) -> int:
    """Run TPC-H server benchmark (VibeSQL server vs MySQL)."""
    print("\n" + "=" * 60)
    print("TPC-H Server Benchmark (PostgreSQL Wire Protocol)")
    print("=" * 60)

    # Build features based on selected engines
    features = []
    if "mysql" in config.engines:
        features.append("mysql")

    # Build benchmark and get the correct binary path
    print("Building TPC-H server benchmark...")
    bench_bin = build_bench_and_get_binary("vibesql-server", "tpch_server", features if features else None)

    if not bench_bin:
        print("❌ Build failed")
        return 1

    print(f"  ✓ Built: {bench_bin}")
    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    scale_factor = config.scale or 0.01
    warmup_iterations = 1
    benchmark_iterations = 3 if not config.quick else 1

    env["SCALE_FACTOR"] = str(scale_factor)
    env["WARMUP_ITERATIONS"] = str(warmup_iterations)
    env["BENCHMARK_ITERATIONS"] = str(benchmark_iterations)

    # Query filter
    if config.queries:
        env["QUERY_FILTER"] = ",".join(config.queries)

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("tpch-server", "mysql", "Docker not available")

    print(f"\nRunning TPC-H server (SF={scale_factor})...")
    result = subprocess.run(
        [bench_bin],
        cwd=Path(__file__).parent.parent,
        env=env,
        capture_output=True,
        text=True
    )

    # Print stderr (progress/debug) to console
    if result.stderr:
        print(result.stderr)

    if result.returncode != 0:
        print("⚠ TPC-H server benchmark completed with warnings")
    else:
        print("✓ TPC-H server benchmark completed")

    # Parse JSON output from stdout and write to results file
    _process_tpch_server_results(result.stdout)

    return 0


def _process_tpch_server_results(json_output: str) -> None:
    """Parse TPC-H server results and write to tpch_server_results.json."""
    import re

    # Find the JSON blob in the output (starts with { and ends with })
    json_match = re.search(r'\{[\s\S]*\}', json_output)
    if not json_match:
        print("  No JSON results found in output")
        return

    try:
        data = json.loads(json_match.group())
    except json.JSONDecodeError as e:
        print(f"  Failed to parse JSON: {e}")
        return

    # Add git info
    git_info = get_git_info()
    if "metadata" not in data:
        data["metadata"] = {}
    data["metadata"]["git_commit"] = git_info.get("commit", "unknown")
    data["metadata"]["timestamp"] = datetime.now().isoformat()

    # Write to results file
    json_path = Path(__file__).parent.parent / "web-demo" / "public" / "benchmarks" / "tpch_server_results.json"
    with open(json_path, 'w') as f:
        json.dump(data, f, indent=2)

    benchmark_count = len(data.get("benchmarks", []))
    print(f"  Wrote {benchmark_count} results to {json_path.name}")


def run_tpcc_server(config: BenchConfig) -> int:
    """Run TPC-C server benchmark (VibeSQL server vs MySQL)."""
    print("\n" + "=" * 60)
    print("TPC-C Server Benchmark (PostgreSQL Wire Protocol)")
    print("=" * 60)

    # Build features based on selected engines
    features = []
    if "mysql" in config.engines:
        features.append("mysql")

    # Build benchmark and get the correct binary path
    print("Building TPC-C server benchmark...")
    bench_bin = build_bench_and_get_binary("vibesql-server", "tpcc_server", features if features else None)

    if not bench_bin:
        print("❌ Build failed")
        return 1

    print(f"  ✓ Built: {bench_bin}")
    strip_quarantine()

    # Set up environment
    env = os.environ.copy()
    duration = config.duration or 60
    warmup = max(1, duration // 6)
    scale_factor = int(config.scale) if config.scale else 1

    env["TPCC_DURATION_SECS"] = str(duration)
    env["TPCC_WARMUP_SECS"] = str(warmup)
    env["TPCC_SCALE_FACTOR"] = str(scale_factor)

    # Transaction filter
    if config.transactions and len(config.transactions) == 1:
        # TPC-C benchmark accepts transaction type as CLI arg
        pass  # Will be added to command below

    # Try to start MySQL if needed
    if "mysql" in config.engines:
        print("\nStarting MySQL Docker container...")
        result = subprocess.run(
            ["./scripts/ensure-mysql-docker.sh"],
            cwd=Path(__file__).parent.parent,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            env["MYSQL_URL"] = result.stdout.strip()
            print(f"✓ MySQL ready: {env['MYSQL_URL']}")
        else:
            print("⚠ MySQL unavailable (Docker not available)")
            record_skipped_engine("tpcc-server", "mysql", "Docker not available")

    # Build command with transaction filter if specified
    cmd = [bench_bin]
    if config.transactions and len(config.transactions) == 1:
        txn_type = config.transactions[0].lower().replace("_", "-")
        cmd.append(txn_type)
        print(f"Transaction filter: {txn_type}")

    print(f"\nRunning TPC-C server (duration={duration}s, warehouses={scale_factor})...")
    result = subprocess.run(
        cmd,
        cwd=Path(__file__).parent.parent,
        env=env,
        capture_output=True,
        text=True
    )

    # Print stderr (progress/debug) to console
    if result.stderr:
        print(result.stderr)

    if result.returncode != 0:
        print("⚠ TPC-C server benchmark completed with warnings")
    else:
        print("✓ TPC-C server benchmark completed")

    # Parse JSON output from stdout and write to results file
    _process_tpcc_server_results(result.stdout)

    return 0


