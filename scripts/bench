def format_duration(seconds: float) -> str:
    """Format duration in human-readable form."""
    if seconds < 1:
        return f"{seconds * 1000:.1f}ms"
    elif seconds < 60:
        return f"{seconds:.2f}s"
    elif seconds < 3600:
        mins = int(seconds // 60)
        secs = seconds % 60
        return f"{mins}m {secs:.1f}s"
    else:
        hours = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        return f"{hours}h {mins}m"


def print_summary_table(results: Dict[str, BenchmarkResult]) -> None:
    """Print a formatted summary table of benchmark results."""
    print("\n" + "=" * 70)
    print("BENCHMARK SUMMARY")
    print("=" * 70)
    print(f"{'Benchmark':<16} {'Status':<10} {'Duration':<12} {'Queries':<12} {'Notes'}")
    print("-" * 70)

    for test, result in results.items():
        status_icon = "✓" if result.status == "success" else "⚠" if result.status == "partial" else "✗"
        duration_str = format_duration(result.duration_secs)

        if result.queries_total > 0:
            queries_str = f"{result.queries_passed}/{result.queries_total}"
        elif result.tps:
            queries_str = f"{result.tps:.0f} TPS"
        else:
            queries_str = "-"

        notes = result.error or ""
        print(f"{test.upper():<16} {status_icon:<10} {duration_str:<12} {queries_str:<12} {notes}")

    print("=" * 70)


def export_json_results(results: Dict[str, BenchmarkResult], config: BenchConfig) -> Dict[str, Any]:
    """Export benchmark results to JSON format."""
    git_info = get_git_info()

    # Build JSON structure
    output = {
        "metadata": {
            "timestamp": datetime.now().isoformat(),
            "git_commit": git_info.get("commit", "unknown"),
            "git_branch": git_info.get("branch", "unknown"),
            "config": {
                "engines": config.engines,
                "scale": config.scale,
                "timeout": config.timeout,
                "duration": config.duration,
                "test_mode": config.test_mode,
            }
        },
        "benchmarks": {}
    }

    for test, result in results.items():
        output["benchmarks"][test] = {
            "status": result.status,
            "duration_secs": round(result.duration_secs, 3),
            "queries_passed": result.queries_passed,
            "queries_total": result.queries_total,
        }
        if result.tps:
            output["benchmarks"][test]["tps"] = round(result.tps, 2)
        if result.error:
            output["benchmarks"][test]["error"] = result.error
        if result.details:
            output["benchmarks"][test]["details"] = result.details

    return output


def run_all(config: BenchConfig) -> int:
    """Run all benchmarks."""
    print("\n" + "=" * 60)
    print("Running ALL BENCHMARKS")
    print("=" * 60)

    # Suppress intermediate comparison summaries when running all benchmarks
    # The final summary and export will provide complete comparison data
    os.environ["SUPPRESS_COMPARISON_SUMMARY"] = "1"

    results: Dict[str, BenchmarkResult] = {}
    start_time = datetime.now()

    # Define benchmark list based on mode
    # In smoke test mode, include server benchmarks for fair MySQL comparison
    # TPC-DS now supports QUERY_FILTER, so we include it for full pipeline validation
    # Note: `hnsw` is intentionally NOT in this list. It is run as its own phase
    # in `scripts/bench-all` (via `make benchmark-hnsw`) so a failure or skip in
    # the latency suites does not silently drop the recall@k measurements from
    # the trends dashboard. See #5645. Direct callers of `./scripts/bench
    # --test=all` who want HNSW should additionally invoke `--test=hnsw`.
    if config.test_mode:
        benchmarks = ["tpch", "tpcc", "tpcds", "sysbench", "sysbench-server", "tpch-server", "tpcc-server"]
        print("Note: Skipping footprint in smoke test mode")
    else:
        # Full benchmark suite includes server benchmarks and footprint
        benchmarks = ["tpch", "tpcc", "tpcds", "sysbench", "sysbench-server", "tpch-server", "tpcc-server", "footprint"]

    for test in benchmarks:
        config.test = test
        print(f"\n[{test.upper()}] Starting...")
        test_start = datetime.now()

        if test == "tpch":
            ret = run_tpch(config)
        elif test == "tpcc":
            ret = run_tpcc(config)
        elif test == "tpcds":
            ret = run_tpcds(config)
        elif test == "sysbench":
            ret = run_sysbench(config)
        elif test == "hnsw":
            ret = run_hnsw(config)
        elif test == "sysbench-server":
            ret = run_sysbench_server(config)
        elif test == "tpch-server":
            ret = run_tpch_server(config)
        elif test == "tpcc-server":
            ret = run_tpcc_server(config)
        elif test == "footprint":
            ret = run_footprint(config)
        else:
            ret = 1

        test_duration = (datetime.now() - test_start).total_seconds()
        results[test] = BenchmarkResult(
            test=test,
            status="success" if ret == 0 else "failed",
            duration_secs=test_duration,
        )

        if ret != 0:
            print(f"⚠ {test.upper()} had issues, continuing...")

    # Print formatted summary
    print_summary_table(results)

    total_duration = (datetime.now() - start_time).total_seconds()
    print(f"\nTotal time: {format_duration(total_duration)}")

    # JSON export if requested
    if config.json_export:
        json_output = export_json_results(results, config)
        if config.output:
            with open(config.output, 'w') as f:
                json.dump(json_output, f, indent=2)
            print(f"\nJSON results written to: {config.output}")
        else:
            print("\n--- JSON Output ---")
            print(json.dumps(json_output, indent=2))

    # Show analysis (unless in JSON mode to stdout)
    if not config.json_export or config.output:
        print("\nRunning analysis...")
        subprocess.run(
            ["./scripts/query_benchmark_results.py", "--latest"],
            cwd=Path(__file__).parent.parent
        )

    # Note: JSON export is handled separately by 'make website'
    # This keeps benchmark-all focused on data collection (dogfooding VibeSQL)
    print("\n" + "=" * 60)
    print("Benchmark data stored in VibeSQL database")
    print("Run 'make website' to export data to web demo JSON files")
    print("=" * 60)

    return 0


def ensure_python_bindings():
    """Ensure Python bindings are built and up to date."""
    print("Checking Python bindings...")

    # Check if vibesql module exists and get its location
    try:
        import vibesql
        module_path = Path(vibesql.__file__).parent
        so_file = module_path / "vibesql.abi3.so"

        if so_file.exists():
            so_mtime = so_file.stat().st_mtime

            # Check if any Rust source files are newer than the .so
            rust_sources = list(Path("crates").rglob("*.rs"))
            newest_rust = max((f.stat().st_mtime for f in rust_sources), default=0)

            if newest_rust > so_mtime:
                print("  Python bindings are outdated, rebuilding...")
            else:
                print("  Python bindings are up to date")
                return True
        else:
            print("  Python bindings not found, building...")
    except ImportError:
        print("  Python bindings not installed, building...")

    # Build and install Python bindings
    result = subprocess.run(
        ["make", "build-python"],
        cwd=Path(__file__).parent.parent,
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        print(f"⚠ Failed to build Python bindings: {result.stderr}")
        return False

    # Find and install the wheel (select most recent by mtime)
    wheels = list(Path("target/wheels").glob("vibesql-*.whl"))
    if wheels:
        wheel_path = max(wheels, key=lambda w: w.stat().st_mtime)
        print(f"  Installing wheel: {wheel_path.name}")
        result = subprocess.run(
            ["pip3", "install", "--force-reinstall", "--quiet", "--break-system-packages", str(wheel_path)],
            cwd=Path(__file__).parent.parent
        )
        if result.returncode == 0:
            print("  ✓ Python bindings installed")
            return True

    print("⚠ Failed to install Python bindings")
    return False


def main():
    """Main entry point."""
    parser = create_parser()
    args = parser.parse_args()

    # Ensure Python bindings are up to date for result storage
    ensure_python_bindings()

    # Parse arguments into config
    try:
        config = build_config(args)
    except ValueError as e:
        print(f"❌ Error: {e}")
        return 1
    
    # Print configuration (unless JSON to stdout)
    if not config.json_export or config.output:
        print(f"Configuration:")
        print(f"  Test:    {config.test}")
        print(f"  Engines: {', '.join(config.engines)}")
        if config.queries:
            print(f"  Queries: {', '.join(config.queries)}")
        if config.transactions:
            print(f"  Txns:    {', '.join(config.transactions)}")
        if config.timeout:
            print(f"  Timeout: {config.timeout}s")
        if config.duration:
            print(f"  Duration: {config.duration}s")
        if config.scale:
            print(f"  Scale:   {config.scale}")
        if config.json_export:
            output_dest = config.output if config.output else "stdout"
            print(f"  JSON:    {output_dest}")
        if config.verbose:
            print(f"  Verbose: enabled")

    # Clean benchmark crates to ensure fresh builds
    clean_benchmark_crates()

    # Run benchmark(s)
    if config.test == "all":
        return run_all(config)
    elif config.test == "tpch":
        return run_tpch(config)
    elif config.test == "tpcc":
        return run_tpcc(config)
    elif config.test == "tpcds":
        return run_tpcds(config)
    elif config.test == "sysbench":
        return run_sysbench(config)
    elif config.test == "hnsw":
        return run_hnsw(config)
    elif config.test == "tpch-server":
        return run_tpch_server(config)
    elif config.test == "tpcc-server":
        return run_tpcc_server(config)
    elif config.test == "sysbench-server":
        return run_sysbench_server(config)
    else:
        print(f"❌ Unknown test: {config.test}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
