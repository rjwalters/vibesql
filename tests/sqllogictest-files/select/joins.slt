# JOIN operations

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR(50))

statement ok
CREATE TABLE orders (id INTEGER, customer_id INTEGER, amount INTEGER)

statement ok
INSERT INTO customers VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie')

statement ok
INSERT INTO orders VALUES (1, 1, 100), (2, 1, 200), (3, 2, 150)

# INNER JOIN
query ITI rowsort
SELECT c.id, c.name, o.amount FROM customers c INNER JOIN orders o ON c.id = o.customer_id
----
1 Alice 100
1 Alice 200
2 Bob 150

# LEFT JOIN
query ITI rowsort
SELECT c.id, c.name, o.amount FROM customers c LEFT JOIN orders o ON c.id = o.customer_id
----
1 Alice 100
1 Alice 200
2 Bob 150
3 Charlie NULL

# Aggregate with JOIN (note: SUM returns 0 instead of NULL for no rows - known issue)
query TI rowsort
SELECT c.name, SUM(o.amount) FROM customers c LEFT JOIN orders o ON c.id = o.customer_id GROUP BY c.name
----
Alice 300
Bob 150
Charlie 0

statement ok
DROP TABLE orders

statement ok
DROP TABLE customers

# Issue #4466: table.* should return all columns in NATURAL JOIN context
statement ok
CREATE TABLE t1(a, b, c)

statement ok
CREATE TABLE t2(b, c, d)

statement ok
INSERT INTO t1 VALUES(1, 2, 3)

statement ok
INSERT INTO t2 VALUES(2, 3, 4)

# SELECT t1.* from NATURAL JOIN should return all columns from t1
query III rowsort
SELECT t1.* FROM t2 NATURAL JOIN t1
----
1 2 3

# SELECT t2.* from NATURAL JOIN should return all columns from t2
query III rowsort
SELECT t2.* FROM t2 NATURAL JOIN t1
----
2 3 4

# SELECT * from NATURAL JOIN should deduplicate columns
query IIII rowsort
SELECT * FROM t2 NATURAL JOIN t1
----
2 3 4 1

# Mixed wildcards should return all columns from each table
query IIIIII rowsort
SELECT t1.*, t2.* FROM t2 NATURAL JOIN t1
----
1 2 3 2 3 4

# USING clause: table.* should return all columns
query III rowsort
SELECT t1.* FROM t1 JOIN t2 USING(b, c)
----
1 2 3

# USING clause: SELECT * should deduplicate columns
query IIII rowsort
SELECT * FROM t1 JOIN t2 USING(b, c)
----
1 2 3 4

statement ok
DROP TABLE t1

statement ok
DROP TABLE t2

# Issue #4798: RIGHT JOIN followed by INNER JOIN incorrectly filters rows
# When a RIGHT JOIN is followed by an INNER JOIN on the same USING column,
# rows preserved by the RIGHT JOIN should not be filtered out.
statement ok
CREATE TABLE rj_t1(a INT, b INT, c INT)

statement ok
CREATE TABLE rj_t2(a INT, b INT, d INT)

statement ok
CREATE TABLE rj_t3(a INT, b INT, e INT)

statement ok
CREATE TABLE rj_t4(a INT, b INT, f INT)

statement ok
CREATE TABLE rj_t5(a INT, b INT, g INT)

statement ok
INSERT INTO rj_t1 VALUES(15,25,35)

statement ok
INSERT INTO rj_t2 VALUES(15,25,35)

statement ok
INSERT INTO rj_t3 VALUES(15,25,35)

statement ok
INSERT INTO rj_t4 VALUES(15,25,35),(19,29,39)

statement ok
INSERT INTO rj_t5 VALUES(15,25,35),(19,29,39)

# After RIGHT JOIN t4 USING(a), the result should have rows with a=15 and a=19.
# The subsequent INNER JOIN t5 USING(a) should match both rows since t5 has both values.
# Expected: 2 rows (a=15 and a=19)
query III rowsort
SELECT a, rj_t4.a, rj_t5.a FROM rj_t1 INNER JOIN rj_t2 USING(a) INNER JOIN rj_t3 USING(a) RIGHT JOIN rj_t4 USING(a) INNER JOIN rj_t5 USING(a)
----
15 15 15
19 19 19

# Also test that NULL values from the RIGHT JOIN are preserved correctly
query IIIII rowsort
SELECT a, rj_t1.a, rj_t2.a, rj_t4.a, rj_t5.a FROM rj_t1 INNER JOIN rj_t2 USING(a) RIGHT JOIN rj_t4 USING(a) INNER JOIN rj_t5 USING(a)
----
15 15 15 15 15
19 NULL NULL 19 19

# Test NATURAL RIGHT JOIN followed by INNER JOIN
query I rowsort
SELECT a FROM rj_t1 NATURAL RIGHT JOIN rj_t4 INNER JOIN rj_t5 USING(a)
----
15
19

statement ok
DROP TABLE rj_t1

statement ok
DROP TABLE rj_t2

statement ok
DROP TABLE rj_t3

statement ok
DROP TABLE rj_t4

statement ok
DROP TABLE rj_t5
