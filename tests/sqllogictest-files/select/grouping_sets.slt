# ============================================================================
# GROUPING() Function Tests
# ============================================================================

# GROUPING() with ROLLUP - shows which columns are rolled up
query IIII rowsort
SELECT year, GROUPING(year), SUM(amount), COUNT(*) FROM sales GROUP BY ROLLUP(year)
----
2023
0
570
4
2024
0
320
2
NULL
1
890
6

