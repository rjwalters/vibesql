# ROLLUP, CUBE, and GROUPING SETS tests (SQL:1999 OLAP Extensions)
# Tests multi-dimensional aggregation for data warehousing queries

# Create sales table for testing
statement ok
CREATE TABLE sales (
    year INTEGER,
    quarter INTEGER,
    region TEXT,
    product TEXT,
    amount INTEGER
)

# Insert test data
statement ok
INSERT INTO sales VALUES (2023, 1, 'East', 'Widget', 100)

statement ok
INSERT INTO sales VALUES (2023, 1, 'West', 'Widget', 150)

statement ok
INSERT INTO sales VALUES (2023, 2, 'East', 'Widget', 120)

statement ok
INSERT INTO sales VALUES (2023, 2, 'West', 'Gadget', 200)

statement ok
INSERT INTO sales VALUES (2024, 1, 'East', 'Gadget', 180)

statement ok
INSERT INTO sales VALUES (2024, 1, 'West', 'Widget', 140)

# ============================================================================
# ROLLUP Tests
# ============================================================================

# ROLLUP with single column
# ROLLUP(year) produces: (year), ()
query II rowsort
SELECT year, SUM(amount) FROM sales GROUP BY ROLLUP(year)
----
2023
570
2024
320
NULL
890

# ROLLUP with two columns
# ROLLUP(year, quarter) produces: (year, quarter), (year), ()
query III rowsort
SELECT year, quarter, SUM(amount) FROM sales GROUP BY ROLLUP(year, quarter)
----
2023
1
250
2023
2
320
2023
NULL
