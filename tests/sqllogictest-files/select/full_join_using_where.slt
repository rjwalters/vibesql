statement ok
DROP TABLE fj_t3

statement ok
DROP TABLE fj_t4

statement ok
DROP TABLE fj_t5

statement ok
DROP TABLE fj_t6

statement ok
DROP TABLE fj_t7

statement ok
DROP TABLE fj_left

statement ok
