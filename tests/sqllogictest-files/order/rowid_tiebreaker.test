# The original failing test from where.test
# With a=4 and (b=1 OR c=1), we should get rows in rowid order: (4,1,0) then (4,0,1)
query III nosort
SELECT * FROM t12 WHERE
a = (SELECT * FROM (SELECT count(*) FROM t13 LIMIT 5) ORDER BY 1 LIMIT 10)
AND (b=1 OR c=1)
----
4 1 0
4 0 1

