# SQLite mode for integer division tests
dialect sqlite

statement ok
CREATE TABLE tab0(col0 INTEGER, col1 INTEGER, col2 INTEGER)

statement ok
INSERT INTO tab0 VALUES(97,1,99)

statement ok
INSERT INTO tab0 VALUES(15,81,47)

statement ok
INSERT INTO tab0 VALUES(87,21,10)

query I rowsort
SELECT - col1 FROM tab0
----
-1
-21
-81

query I rowsort
SELECT - 9 / - col2 FROM tab0
----
0
0
0

query I rowsort
SELECT - 9 FROM tab0
----
-9
-9
-9

query I rowsort
SELECT col1 FROM tab0
----
1
21
81

query I rowsort
SELECT - col1 + 0 FROM tab0
----
-1
-21
-81

query I rowsort
SELECT - col1 + - 9 / - col2 FROM tab0
----
-1
-21
-81
