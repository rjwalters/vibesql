# VibeSQL Configuration File Example
#
# Copy this file to ~/.vibesqlrc to customize your VibeSQL CLI experience
#
# Usage:
#   cp .vibesqlrc.example ~/.vibesqlrc
#   # Edit ~/.vibesqlrc with your preferences
#   vibesql
#
# All settings are optional. If not specified, sensible defaults are used.

# ============================================================================
# Display Settings
# ============================================================================
[display]
# Output format for query results
# Options: "table", "json", "csv"
# Default: "table"
# Can be overridden with --format CLI flag or \f meta-command
format = "table"

# ============================================================================
# Database Settings
# ============================================================================
[database]
# Default database file to load on startup
# Leave commented to start with empty database
# Example: default_path = "/Users/username/databases/mydb.sql"
# default_path = ""

# Automatically save database when exiting
# Only works if default_path is set or --database flag was used
# Default: true
auto_save = true

# Write-Ahead Log (WAL) durability for file-backed databases.
# When true, committed DDL and DML survive an unclean shutdown (crash, SIGKILL,
# power loss) by replaying the WAL from the last checkpoint on open.
# Default: true
# wal = true

# Busy timeout (milliseconds) for the exclusive inter-process database lock.
# A second session opening the same file-backed database waits up to this long
# before failing with "database is locked". 0 = fail immediately.
# Default: 5000
# lock_timeout_ms = 5000

# Number of checkpoint files to retain in <stem>-checkpoints/ after each save.
# Each \save / clean exit writes a new checkpoint; the oldest are pruned so the
# archive does not grow unboundedly. Keeping more than 1 lets --recover-fallback
# fall back to an older checkpoint. A value of 0 is clamped to 1 so the newest
# checkpoint always survives.
# Default: 2
# keep_checkpoints = 2

# ============================================================================
# History Settings
# ============================================================================
[history]
# Location of command history file
# Supports ~ for home directory
# Default: "~/.vibesql_history"
file = "~/.vibesql_history"

# Maximum number of history entries to keep
# Older entries are automatically removed
# Default: 10000
max_entries = 10000

# ============================================================================
# Query Settings
# ============================================================================
[query]
# Query timeout in seconds
# Set to 0 for no timeout (useful for long-running queries)
# Default: 0
timeout_seconds = 30

# ============================================================================
# Example Configurations
# ============================================================================

# MINIMAL CONFIGURATION - Just JSON output
# [display]
# format = "json"

# DEVELOPER CONFIGURATION - Extended history, no timeout
# [display]
# format = "json"
#
# [history]
# max_entries = 50000
#
# [query]
# timeout_seconds = 0

# PRODUCTION CONFIGURATION - Auto-load database, auto-save
# [display]
# format = "table"
#
# [database]
# default_path = "/Users/alice/databases/production.sql"
# auto_save = true
#
# [query]
# timeout_seconds = 60

# DATA ANALYST CONFIGURATION - CSV output by default
# [display]
# format = "csv"
#
# [database]
# default_path = "/Users/bob/analytics/data.sql"
